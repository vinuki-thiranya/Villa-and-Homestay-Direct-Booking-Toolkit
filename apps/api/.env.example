# --- database (Supabase Singapore: Project settings → Database → Session pooler URI) ---
DATABASE_URL=postgres://postgres:postgres@localhost:54329/staydirect
# Optional: point the integration tests at a disposable database instead of the embedded one
# TEST_DATABASE_URL=

# --- redis (Upstash, rediss://…). Leave empty in dev to use the in-process scheduler ---
REDIS_URL=

PORT=4000
JWT_SECRET=change-me-to-32-random-bytes-base64
# 32 bytes base64 — encrypts each property's gateway credentials. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=
ROOT_DOMAIN=staydirect.lk
# Where the API is reachable from the internet (PayHere notify_url, iCal export links)
PUBLIC_API_URL=http://localhost:4000
# Base for guest-site links in emails when a property has no custom domain (dev: http://localhost:3000/s)
WEB_URL=http://localhost:3000/s
OWNER_APP_URL=http://localhost:3000/owner
CORS_ORIGINS=http://localhost:3000

# --- owner OTP ---
SMS_PROVIDER=console
# Only honoured with SMS_PROVIDER=console: accept this code for any phone (demo/dev)
OTP_DEV_CODE=123456
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# --- email (Resend). Empty key → emails are logged, not sent ---
RESEND_API_KEY=
EMAIL_FROM=StayDirect LK <bookings@staydirect.lk>

# --- WhatsApp Cloud API (platform number used for owner alerts) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TEMPLATE=owner_alert
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- AI concierge (Release 2). Empty key → concierge off, messages go to the inbox only ---
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-opus-5-5
CONCIERGE_EFFORT=low
CONCIERGE_MONTHLY_BUDGET_USD=1

# --- payments (merchant credentials are per property, entered by the owner) ---
PAYHERE_SANDBOX=true
PAYPAL_SANDBOX=true

# --- Cloudflare R2. Empty → files are written to ./.uploads and served by the API ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=staydirect
R2_PUBLIC_URL=

FX_FEED_URL=https://open.er-api.com/v6/latest/USD

# Next.js on-demand revalidation
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me

SENTRY_DSN=
