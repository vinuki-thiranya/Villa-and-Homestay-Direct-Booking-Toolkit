{
  "name": "@staydirect/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch-path=dist --enable-source-maps dist/src/main.js\"",
    "dev:worker": "node --env-file-if-exists=.env --enable-source-maps dist/src/worker.js",
    "start": "node --enable-source-maps dist/src/main.js",
    "start:worker": "node --enable-source-maps dist/src/worker.js",
    "db:local": "node --env-file-if-exists=.env scripts/local-db.mjs",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "db:seed": "npm run build && node --env-file-if-exists=.env dist/scripts/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "whatsapp:templates": "npm run build && node --env-file-if-exists=.env dist/scripts/submit-whatsapp-templates.js",
    "restore-drill": "npm run build && node --env-file-if-exists=.env dist/scripts/restore-drill.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@sentry/node": "10.76.2",
    "@staydirect/shared": "*",
    "aws4fetch": "^1.0.20",
    "bullmq": "^6.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.0",
    "concurrently": "^10.0.0",
    "embedded-postgres": "17.11.0-beta.19",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.0.0"
  }
}
