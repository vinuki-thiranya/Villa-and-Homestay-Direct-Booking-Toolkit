# Server-side API base (inside Vercel → Fly.io Singapore)
API_URL=http://localhost:4000
# Browser-side API base (guest checkout, availability search)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Guest sites resolve as {slug}.ROOT_DOMAIN; the owner app lives on OWNER_HOST
ROOT_DOMAIN=staydirect.lk
OWNER_HOST=app.staydirect.lk
# Must match the API's REVALIDATE_SECRET
REVALIDATE_SECRET=change-me
